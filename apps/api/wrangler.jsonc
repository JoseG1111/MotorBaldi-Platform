{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "motorbaldi-api-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": {
    "ENVIRONMENT": "local",
    "AUTH_BASE_URL": "http://localhost:8787",
    "CORS_ORIGINS": "http://localhost:5173,http://localhost:5174",
    "EMAIL_PROVIDER": "DEVELOPMENT_SINK",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "motorbaldi-core-dev",
      "database_id": "REPLACE_WITH_LOCAL_D1_DATABASE_ID",
      "migrations_dir": "../../migrations",
    },
  ],
  "r2_buckets": [
    { "binding": "PRIVATE_BUCKET", "bucket_name": "motorbaldi-private-dev" },
  ],
  "queues": {
    "producers": [
      { "binding": "EVENTS_QUEUE", "queue": "motorbaldi-events-dev" },
    ],
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "IDEMPOTENCY_COORDINATOR",
        "class_name": "IdempotencyCoordinator",
      },
      { "name": "OUTBOX_COORDINATOR", "class_name": "OutboxCoordinator" },
    ],
  },
  "exports": {
    "IdempotencyCoordinator": { "type": "durable-object", "storage": "sqlite" },
    "OutboxCoordinator": { "type": "durable-object", "storage": "sqlite" },
  },
  "ratelimits": [
    {
      "name": "API_RATE_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 120, "period": 60 },
    },
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1002",
      "simple": { "limit": 10, "period": 60 },
    },
  ],
  "env": {
    "development": {
      "name": "motorbaldi-api-development",
      "vars": {
        "ENVIRONMENT": "development",
        "AUTH_BASE_URL": "https://REPLACE_WITH_DEVELOPMENT_API_WORKER_URL",
        "CORS_ORIGINS": "https://REPLACE_WITH_DEVELOPMENT_PORTAL_URL,https://REPLACE_WITH_DEVELOPMENT_ADMIN_URL",
        "EMAIL_PROVIDER": "DEVELOPMENT_SINK",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "motorbaldi-core-dev",
          "database_id": "REPLACE_WITH_DEVELOPMENT_D1_DATABASE_ID",
          "migrations_dir": "../../migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "PRIVATE_BUCKET",
          "bucket_name": "motorbaldi-private-dev",
        },
      ],
      "queues": {
        "producers": [
          { "binding": "EVENTS_QUEUE", "queue": "motorbaldi-events-dev" },
        ],
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "IDEMPOTENCY_COORDINATOR",
            "class_name": "IdempotencyCoordinator",
          },
          { "name": "OUTBOX_COORDINATOR", "class_name": "OutboxCoordinator" },
        ],
      },
      "ratelimits": [
        {
          "name": "API_RATE_LIMITER",
          "namespace_id": "1101",
          "simple": { "limit": 120, "period": 60 },
        },
        {
          "name": "AUTH_RATE_LIMITER",
          "namespace_id": "1102",
          "simple": { "limit": 10, "period": 60 },
        },
      ],
    },
    "staging": {
      "name": "motorbaldi-api-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "AUTH_BASE_URL": "https://REPLACE_WITH_STAGING_API_WORKER_URL",
        "CORS_ORIGINS": "https://REPLACE_WITH_STAGING_PORTAL_URL,https://REPLACE_WITH_STAGING_ADMIN_URL",
        "EMAIL_PROVIDER": "UNCONFIGURED",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "motorbaldi-core-staging",
          "database_id": "REPLACE_WITH_STAGING_D1_DATABASE_ID",
          "migrations_dir": "../../migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "PRIVATE_BUCKET",
          "bucket_name": "motorbaldi-private-staging",
        },
      ],
      "queues": {
        "producers": [
          { "binding": "EVENTS_QUEUE", "queue": "motorbaldi-events-staging" },
        ],
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "IDEMPOTENCY_COORDINATOR",
            "class_name": "IdempotencyCoordinator",
          },
          { "name": "OUTBOX_COORDINATOR", "class_name": "OutboxCoordinator" },
        ],
      },
      "ratelimits": [
        {
          "name": "API_RATE_LIMITER",
          "namespace_id": "1201",
          "simple": { "limit": 120, "period": 60 },
        },
        {
          "name": "AUTH_RATE_LIMITER",
          "namespace_id": "1202",
          "simple": { "limit": 10, "period": 60 },
        },
      ],
    },
    "production": {
      "name": "motorbaldi-api-production",
      "vars": {
        "ENVIRONMENT": "production",
        "AUTH_BASE_URL": "https://REPLACE_WITH_PRODUCTION_API_WORKER_URL",
        "CORS_ORIGINS": "https://REPLACE_WITH_PRODUCTION_PORTAL_URL,https://REPLACE_WITH_PRODUCTION_ADMIN_URL",
        "EMAIL_PROVIDER": "UNCONFIGURED",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "motorbaldi-core-prod",
          "database_id": "REPLACE_WITH_PRODUCTION_D1_DATABASE_ID",
          "migrations_dir": "../../migrations",
        },
      ],
      "r2_buckets": [
        {
          "binding": "PRIVATE_BUCKET",
          "bucket_name": "motorbaldi-private-prod",
        },
      ],
      "queues": {
        "producers": [
          { "binding": "EVENTS_QUEUE", "queue": "motorbaldi-events-prod" },
        ],
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "IDEMPOTENCY_COORDINATOR",
            "class_name": "IdempotencyCoordinator",
          },
          { "name": "OUTBOX_COORDINATOR", "class_name": "OutboxCoordinator" },
        ],
      },
      "ratelimits": [
        {
          "name": "API_RATE_LIMITER",
          "namespace_id": "1301",
          "simple": { "limit": 120, "period": 60 },
        },
        {
          "name": "AUTH_RATE_LIMITER",
          "namespace_id": "1302",
          "simple": { "limit": 10, "period": 60 },
        },
      ],
    },
  },
}
