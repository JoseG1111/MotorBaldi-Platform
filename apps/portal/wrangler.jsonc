{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "motorbaldi-portal-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-23",
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": { "ENVIRONMENT": "local" },
  "services": [{ "binding": "API_SERVICE", "service": "motorbaldi-api-local" }],
  "env": {
    "development": {
      "name": "motorbaldi-portal-development",
      "vars": { "ENVIRONMENT": "development" },
      "services": [
        { "binding": "API_SERVICE", "service": "motorbaldi-api-development" },
      ],
    },
    "staging": {
      "name": "motorbaldi-portal-staging",
      "vars": { "ENVIRONMENT": "staging" },
      "services": [
        { "binding": "API_SERVICE", "service": "motorbaldi-api-staging" },
      ],
    },
    "production": {
      "name": "motorbaldi-portal-production",
      "vars": { "ENVIRONMENT": "production" },
      "services": [
        { "binding": "API_SERVICE", "service": "motorbaldi-api-production" },
      ],
    },
  },
}
