{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "motorbaldi-worker-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": {
    "ENVIRONMENT": "local",
    "MALWARE_SCANNER_PROVIDER": "DETERMINISTIC_TEST",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "motorbaldi-core-dev",
      "database_id": "REPLACE_WITH_LOCAL_D1_DATABASE_ID",
    },
  ],
  "r2_buckets": [
    { "binding": "PRIVATE_BUCKET", "bucket_name": "motorbaldi-private-dev" },
  ],
  "queues": {
    "consumers": [
      {
        "queue": "motorbaldi-events-dev",
        "dead_letter_queue": "motorbaldi-events-dlq-dev",
      },
    ],
    "producers": [
      { "binding": "EVENTS_QUEUE", "queue": "motorbaldi-events-dev" },
    ],
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "OUTBOX_COORDINATOR",
        "class_name": "OutboxCoordinator",
        "script_name": "motorbaldi-api-local",
      },
    ],
  },
  "triggers": { "crons": ["*/5 * * * *"] },
  "env": {
    "development": {
      "name": "motorbaldi-worker-development",
      "vars": {
        "ENVIRONMENT": "development",
        "MALWARE_SCANNER_PROVIDER": "UNCONFIGURED",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "motorbaldi-core-dev",
          "database_id": "REPLACE_WITH_DEVELOPMENT_D1_DATABASE_ID",
        },
      ],
      "r2_buckets": [
        {
          "binding": "PRIVATE_BUCKET",
          "bucket_name": "motorbaldi-private-dev",
        },
      ],
      "queues": {
        "consumers": [
          {
            "queue": "motorbaldi-events-dev",
            "dead_letter_queue": "motorbaldi-events-dlq-dev",
          },
        ],
        "producers": [
          { "binding": "EVENTS_QUEUE", "queue": "motorbaldi-events-dev" },
        ],
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "OUTBOX_COORDINATOR",
            "class_name": "OutboxCoordinator",
            "script_name": "motorbaldi-api-development",
          },
        ],
      },
    },
    "staging": {
      "name": "motorbaldi-worker-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "MALWARE_SCANNER_PROVIDER": "UNCONFIGURED",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "motorbaldi-core-staging",
          "database_id": "REPLACE_WITH_STAGING_D1_DATABASE_ID",
        },
      ],
      "r2_buckets": [
        {
          "binding": "PRIVATE_BUCKET",
          "bucket_name": "motorbaldi-private-staging",
        },
      ],
      "queues": {
        "consumers": [
          {
            "queue": "motorbaldi-events-staging",
            "dead_letter_queue": "motorbaldi-events-dlq-staging",
          },
        ],
        "producers": [
          { "binding": "EVENTS_QUEUE", "queue": "motorbaldi-events-staging" },
        ],
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "OUTBOX_COORDINATOR",
            "class_name": "OutboxCoordinator",
            "script_name": "motorbaldi-api-staging",
          },
        ],
      },
    },
    "production": {
      "name": "motorbaldi-worker-production",
      "vars": {
        "ENVIRONMENT": "production",
        "MALWARE_SCANNER_PROVIDER": "UNCONFIGURED",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "motorbaldi-core-prod",
          "database_id": "REPLACE_WITH_PRODUCTION_D1_DATABASE_ID",
        },
      ],
      "r2_buckets": [
        {
          "binding": "PRIVATE_BUCKET",
          "bucket_name": "motorbaldi-private-prod",
        },
      ],
      "queues": {
        "consumers": [
          {
            "queue": "motorbaldi-events-prod",
            "dead_letter_queue": "motorbaldi-events-dlq-prod",
          },
        ],
        "producers": [
          { "binding": "EVENTS_QUEUE", "queue": "motorbaldi-events-prod" },
        ],
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "OUTBOX_COORDINATOR",
            "class_name": "OutboxCoordinator",
            "script_name": "motorbaldi-api-production",
          },
        ],
      },
    },
  },
}
