# Foundation: disposable LOCAL values only. Existing .env is not loaded implicitly.
APP_ENV=local
PORT=3000
DATABASE_URL=postgresql://motorbaldi_runtime:motorbaldi_local_runtime@127.0.0.1:55432/motorbaldi_local
MIGRATION_DATABASE_URL=postgresql://motorbaldi_owner:motorbaldi_local_owner@127.0.0.1:55432/motorbaldi_local
REDIS_URL=redis://127.0.0.1:56379
AUTH_SECRET=local-only-replace-with-random-32-byte-secret
AUTH_BASE_URL=http://127.0.0.1:3000
CORS_ORIGINS=http://localhost:5173
STORAGE_ENDPOINT=http://127.0.0.1:59000
STORAGE_REGION=auto
STORAGE_BUCKET=motorbaldi-local
STORAGE_ACCESS_KEY=motorbaldi_local
STORAGE_SECRET_KEY=motorbaldi_local_storage
DB_POOL_MAX=5
WORKER_CONCURRENCY=2
# AUTH_SECRETS=[{"version":1,"value":"replace-with-32-plus-byte-secret-material"}]
# OTEL_EXPORTER_OTLP_ENDPOINT=https://collector.example.invalid
