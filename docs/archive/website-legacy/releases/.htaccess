# Apache / cPanel. Keep hosting-specific PHP/SSL directives outside this file.
DirectoryIndex index.html
ErrorDocument 404 /404.html
Options -Indexes
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Redirect only browser requests, never internal rewrites.
  RewriteCond %{THE_REQUEST} \s/+index\.html(?:[?\s]) [NC]
  RewriteRule ^index\.html$ / [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+pricing\.html(?:[?\s]) [NC]
  RewriteRule ^pricing\.html$ /precios [R=301,L]
  RewriteCond %{THE_REQUEST} \s/+(terminos|politica-de-privacidad|404)\.html(?:[?\s]) [NC]
  RewriteRule ^(terminos|politica-de-privacidad|404)\.html$ /$1 [R=301,L]
  RewriteRule ^(precios|terminos|politica-de-privacidad|404)/+$ /$1 [R=301,L]
  RewriteRule ^precios$ pricing.html [L]
  RewriteRule ^(terminos|politica-de-privacidad|404)$ $1.html [L]
</IfModule>
<IfModule mod_setenvif.c>
  SetEnvIf Host "^staging\.motorbaldi\.com$" STAGING_HOST
</IfModule>
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow, noarchive" env=STAGING_HOST
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set X-Frame-Options "SAMEORIGIN"
  <FilesMatch "\.(html|css|js)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType image/jpeg "access plus 7 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/svg+xml "access plus 7 days"
  ExpiresByType application/manifest+json "access plus 1 day"
  ExpiresByType model/gltf-binary "access plus 30 days"
  ExpiresByType application/octet-stream "access plus 30 days"
</IfModule>
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>
